@ Zero 2's NA-OLD2 AKA Neo Arcadia Temple

.balign 4

.global gApZ2Naold2_Terrain
gApZ2Naold2_Terrain:
	.4byte gApZ2Naold2_Metatiles-.
	.4byte gApZ2Naold2_Attrs-(.-4)
	.4byte gApZ2Naold2_Chunks-(.-8)

.global gApZ2Naold2_Tilesets
gApZ2Naold2_Tilesets: @ ColorGraphic[2]

gApZ2Naold2_Ts0:
	.4byte gApZ2Naold2_Ts0_Tiles-.
	.4byte 7820 | (0 << 22)
	.2byte 256, (LZ77 | BPP4)
		.4byte gApZ2Naold2_Ts0_Pal-.
		.2byte 192
		.byte 0, 2

gApZ2Naold2_Ts1:
	.4byte gApZ2Naold2_Ts1_Tiles-.
	.4byte 8264 | (512 << 22)
	.2byte 256, (LZ77 | BPP4)
		.4byte gApZ2Naold2_Ts1_Pal-.
		.2byte 192
		.byte 0, 9

gApZ2Naold2_Zero:
	.byte PLAYER, ZERO, 0, 0
	.4byte 352*PX, 464*PX
	.4byte DIR_RIGHT

gApZ2Naold2_Camera:
	.byte 6, 8, 0, 0
	.4byte 0*PX, 0*PX
	.4byte 0*PX, 0*PX
	.2byte 0x0, 0x0, 0x0, 0x0
	.4byte 0*PX, MAX_X, 0*PX, MAX_Y

.global gApZ2Naold2_Script
gApZ2Naold2_Script:
	spawn 0, gApZ2Naold2_Zero
	reset_camera gApZ2Naold2_Camera
	lock
	start_transition 9
	wait_transition_end
	play_bgm BGM_Z2_CIRCUIT_SHRINE
	indicator 1, 0, 0
	wait_indicator_end
	release
	resume 0
	end

gApZ2Naold2_AgainZero:
