@ Clear scene skip lands here
.global gApZ2Naold2_ResultScript
gApZ2Naold2_ResultScript:
	backdrop_color 0xFFFF
	start_result_screen
	wait_for_result_screen_end
	lockmenu
	end

gApZ2Naold2_Boss:
	.byte ENTITY_BOSS, BOSS_Z2_BLOB, 0, 0
	.4byte 4992*PX, 464*PX
	.4byte DIR_LEFT

@ Zero 2's script 3
.global gApZ2Naold2_BossScript
gApZ2Naold2_BossScript:
.global gApZ2Naold2_BossReturnScript
gApZ2Naold2_BossReturnScript:
	stop_bgm
	spawn 1, gApZ2Naold2_Boss
	forcekeyinput DPAD_RIGHT
	pause
	wait 8
	lock
	emotion_bubble 0, 24, -40, 0
	entityflag 1, 0, TRUE
	wait 300
	warning_indicator
	wait_indicator_end
	release
	play_bgm BGM_Z2_HARPUIA
	resume 1
	end

@ Zero 2's script 4
.global gApZ2Naold2_ClearScript
gApZ2Naold2_ClearScript:
	forcekeyinput 0xFFFF
	stop_bgm
	wait 1
	lock
	cutscene_start CS_UNK_48
	entityflag 1, 7, TRUE
	cmd08_wait_set 1
	wait 90
	message 1, 0, 0x1422
	wait_msgbox_end
	wait 60
	force 4, 0, 0
	wait 8
	force 5, 0, 0
	wait 60
	start_transition 6
	wait_transition_end
	wait 32
	destroy 1
	stop_camera
	backdrop_color 0xFFFF
	start_transition 5
	wait 60
	cutscene_end
	start_result_screen
	wait_for_result_screen_end
	load_graphic_primitive
	destroy 0
	wait 2
	end

